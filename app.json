{
  "expo": {
    "name": "Ringee",
    "slug": "ringee",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/apple-touch-icon.png",
    "scheme": "ringee",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ringee.mobile",
      "icon": "./assets/images/apple-touch-icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio",
          "voip"
        ],
        "NSMicrophoneUsageDescription": "Ringee needs microphone access to place voice calls."
      }
    },
    "android": {
      "package": "com.ringee.mobile",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-chrome-512x512.png",
        "backgroundColor": "#ffffff"
      },
      "icon": "./assets/images/android-chrome-512x512.png",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon-32x32.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/apple-touch-icon.png",
          "imageWidth": 112,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "image": "./assets/images/apple-touch-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-chrome-192x192.png",
          "color": "#0A0A0A"
        }
      ],
      [
        "react-native-bottom-tabs",
        {
          "theme": "material3"
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "./plugins/withProximitySensor",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5f649f69-9aa0-4636-aa13-c0b2afc63187"
      }
    },
    "owner": "padillacore"
  }
}
